{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}
        {% import "@Elements/_macro-card.twig" as cards %}

        {% set team_members = get_posts(component.team_members) %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content space-y-6">
            <div class="mx-auto space-y-2 text-center lg:max-w-7xl {{ section_class }}__header text-balance">
                {% if has_accent and accent %}
                    <div class="dark:text-cyan-400">
                        {{ badges.render_accent_badge({
                            title: accent,
                        }) }}
                    </div>
                {% endif %}

                {% if has_title and title %}
                    <hgroup class="{{ section_class }}__title">
                        {{ headings.render_heading(2, {
                            title: title,
                            size: 'text-xl md:text-2xl lg:fluid-text-4xl',
                            color: 'dark:text-white',
                            preview: is_preview,
                        }) }}
                    </hgroup>
                {% endif %}
            </div>

            <div class="max-w-3xl mx-auto text-center {{ section_class }}__entry">
                {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                    {% block prose_content %}
                        {{ entry|raw }}
                    {% endblock %}
                {% endembed %}
            </div>

            <ul role="list" class="justify-center w-full lg:-ms-8 lg:translate-x-4 lg:flex lg:flex-wrap {{ section_class }}__list">
                {% for member in team_members %}
                    <li
                        x-data="{ modalIsOpen: false }"
                        id="{{ section_class }}-member-{{ loop.index }}"
                        class="w-full p-4 {{ section_class }}__item inview-item md:w-1/2 lg:w-1/3 xl:w-1/4">
                        {{ cards.team({
                            id: member.id,
                            name: member.title,
                            position: member.meta('position'),
                            image: member.meta('profile_image'),
                            bio: member.meta('bio'),
                            social: member.meta('social_link'),
                        }) }}
                    </li>
                {% endfor %}
            </ul>

            {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'flex items-center justify-center lg:pt-8', list_class: 'lg:flex-row lg:items-center' } only %}
        </div>
    {% endblock %}
{% endembed %}
