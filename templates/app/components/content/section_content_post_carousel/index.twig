{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}
        {% import "@Elements/_macro-card.twig" as cards %}

        {% set entries = component.posts %}
        {% set carousel = component.carousel_options %}
        {% set breakpoints = carousel.breakpoints %}
        {% set is_looping = carousel.loop ? 'true' : 'false' %}
        {% set is_centered = carousel.centered ? 'true' : 'false' %}
        {% set is_auto_playing = carousel.auto_play ? 'true' : 'false' %}
        {% set delay = carousel.delay %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content">
            <article class="pb-2 mx-auto space-y-4 overflow-clip inview-container place-content-center">
                <div class="space-y-4 text-center lg:mx-0 {{ section_class }}__header inview-item">
                    {% if has_accent and accent %}
                        {{ badges.render_accent_badge({
                            title: accent,
                            color: 'text-blue-500',
                        }) }}
                    {% endif %}

                    {% if has_title and title %}
                        <hgroup class="{{ section_class }}__title">
                            {{ headings.render_heading(1, {
                                title: title,
                                size: 'sm:text-5xl',
                                color: 'text-gray-900 dark:text-white',
                                preview: is_preview,
                            }) }}
                        </hgroup>
                    {% endif %}

                    {% if has_entry and entry %}
                        <div class="mx-auto prose text-gray-600 lg:fluid-text-base/7 {{ section_class }}__entry dark:prose-invert">
                            {{ entry|raw }}
                        </div>
                    {% endif %}
                </div>

                <div>
                    {% if is_preview %}
                        <div class="relative grid grid-flow-col-dense gap-8 -translate-x-1/2 auto-cols-max">
                            {% for item in get_posts(entries) %}
                                <div class="max-w-sm slide">
                                    {% if item.type == 'testimonial' %}
                                        {{ item.title|esc_html }}
                                    {% elseif item.type == 'customer-story' %}
                                        {{ cards.customer_story({
                                            id: item.id,
                                            title: item.title,
                                            entry: item.excerpt,
                                            image: item.thumbnail.src ?? null,
                                            image_alt: item.thumbnail.alt ?? '',
                                            link: item.link,
                                        }) }}
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div
                            class="px-1 mt-8 swiper-posts-container {{ section_class }}__swiper"
                            data-swiper='{
                                "slidesPerView": 1,
                                "spaceBetween": 10,
                                "loop": {{ is_looping ? 'true' : 'false' }},
                                "centeredSlides": {{ is_centered }},
                                {% if is_auto_playing %}
                                "autoplay": {
                                    "delay": {{ delay }},
                                    "disableOnInteraction": false
                                },
                                {% endif %}
                                "breakpoints": {
                                    {% for item in breakpoints %}
                                    "{{ item.size }}": {
                                        "slidesPerView": {{ item.slides }},
                                        "spaceBetween": {{ item.spacing }}
                                    }{% if not loop.last %},{% endif %}
                                    {% endfor %}
                                },
                                "pagination": {
                                    "el": ".swiper-pagination",
                                    "clickable": true
                                }
                            }'>
                            <div class="swiper-wrapper">
                                {% for item in get_posts(entries) %}
                                    <div class="swiper-slide">
                                        {% if item.type == 'testimonial' %}
                                            {{ item.title|esc_html }}
                                        {% elseif item.type == 'customer-story' %}
                                            {{ cards.customer_story({
                                                id: item.id,
                                                title: item.title,
                                                entry: item.excerpt,
                                                image: item.thumbnail.src ?? null,
                                                image_alt: item.thumbnail.alt ?? '',
                                                link: item.link,
                                            }) }}
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="bottom-auto! swiper-pagination"></div>
            </article>
        </div>
    {% endblock %}
{% endembed %}
