{% extends "@Layouts/layout-base.twig" %}

{% import "@Elements/_macro-button.twig" as buttons %}
{% import "@Elements/_macro-badge.twig" as badges %}
{% import "@Elements/_macro-card.twig" as cards %}
{% import "@Elements/_macro-icon.twig" as icons %}

{% set panel = 'rounded-lg border border-gray-200 bg-white p-6 shadow-sm' %}
{% set muted = 'text-sm text-gray-600' %}
{% set sections = { overview: 'Overview', colors: 'Colors', typography: 'Typography', spacing: 'Spacing', components: 'Components', icons: 'Icons' } %}

{% block content %}
<div class="brand-guidelines">
    <nav class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur-sm" x-data="{ open: false }" aria-label="Brand guidelines">
        <div class="container flex items-center justify-between h-16 px-4 mx-auto">
            <p class="flex items-center gap-3">
                <span class="text-xl font-bold text-dodger-blue-600">{{ brand.name }}</span>
                <span class="hidden {{ muted }} sm:block">Brand Guidelines</span>
            </p>

            <ul class="items-center hidden gap-1 lg:flex">
                {% for id, label in sections %}
                    <li><a href="#{{ id }}" class="px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100">{{ label }}</a></li>
                {% endfor %}
            </ul>

            <button type="button" class="p-2 rounded-md lg:hidden hover:bg-gray-100" @click="open = !open" :aria-expanded="open.toString()" aria-controls="brand-nav-mobile">
                <span class="sr-only">Toggle sections</span>
                {{ icons.icon({ path: 'controls', name: 'bars-3', classes: ['size-6'] }) }}
            </button>
        </div>

        <ul id="brand-nav-mobile" x-show="open" x-collapse x-cloak class="px-4 pb-4 space-y-1 lg:hidden">
            {% for id, label in sections %}
                <li><a href="#{{ id }}" class="block px-3 py-2 rounded-md hover:bg-gray-100" @click="open = false">{{ label }}</a></li>
            {% endfor %}
        </ul>
    </nav>

    <div class="container px-4 py-12 mx-auto space-y-24 max-w-7xl *:scroll-mt-24">

        <section id="overview" class="max-w-3xl">
            <h1 class="mb-6 text-6xl font-bold">{{ brand.name }}</h1>
            <p class="mb-8 text-2xl text-gray-600">{{ brand.tagline }}</p>
            <div class="prose lg:prose-lg">
                <p>This document defines the visual identity and keeps it consistent across every touchpoint. Use it as the reference for design and development work.</p>
            </div>
        </section>

        <section id="colors" class="space-y-12">
            <h2 class="text-4xl font-bold">Color Palette</h2>

            {% for group, colors in brand.colors %}
                <div>
                    <h3 class="mb-6 text-2xl font-semibold">{{ group|capitalize }} Colors</h3>
                    <ul class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
                        {% for color in colors %}
                            <li class="overflow-hidden border border-gray-200 rounded-lg shadow-sm">
                                <div class="h-28" style="background-color: {{ color.hex }}"></div>
                                <div class="p-4 space-y-1">
                                    <p class="font-semibold">{{ color.name }}</p>
                                    <button type="button" class="font-mono text-sm hover:text-dodger-blue-600" x-data="{ copied: false }" @click="$clipboard('{{ color.hex }}').then(() => { copied = true; setTimeout(() => copied = false, 1500) })" x-text="copied ? 'Copied' : '{{ color.hex }}'">{{ color.hex }}</button>
                                    {% if color.rgb %}<p class="font-mono text-xs text-gray-500">{{ color.rgb }}</p>{% endif %}
                                    {% if color.usage %}<p class="pt-2 {{ muted }}">{{ color.usage }}</p>{% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </section>

        <section id="typography" class="space-y-12">
            <h2 class="text-4xl font-bold">Typography</h2>

            <div>
                <h3 class="mb-6 text-2xl font-semibold">Font Families</h3>
                <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
                    {% for font in brand.typography.families %}
                        <li class="{{ panel }} space-y-2">
                            <p class="text-lg font-semibold">{{ font.name }}</p>
                            <p class="font-mono {{ muted }}">{{ font.font }}</p>
                            <p class="text-sm">Weights: {{ font.weights }}</p>
                            <p class="pt-4 text-2xl" style="font-family: {{ font.font }}">Aa Bb Cc 123</p>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div>
                <h3 class="mb-6 text-2xl font-semibold">Type Scale</h3>
                <ul class="divide-y divide-gray-200 {{ panel }} py-0">
                    {% for type in brand.typography.scale %}
                        <li class="grid items-center grid-cols-1 gap-4 py-6 lg:grid-cols-3">
                            <div>
                                <p class="font-semibold">{{ type.name }}</p>
                                <p class="font-mono {{ muted }}">{{ type.size }} · {{ type.lineHeight }}</p>
                                <p class="text-xs text-gray-500">{{ type.usage }}</p>
                            </div>
                            <p class="lg:col-span-2" style="font-size: {{ type.size|split(' / ')[0] }}; line-height: {{ type.lineHeight }}">The quick brown fox jumps over the lazy dog</p>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <section id="spacing" class="space-y-12">
            <h2 class="text-4xl font-bold">Spacing, Radius &amp; Shadows</h2>

            <ul class="divide-y divide-gray-200 {{ panel }} py-0">
                {% for space in brand.spacing %}
                    <li class="grid items-center grid-cols-1 gap-4 py-4 lg:grid-cols-3">
                        <div>
                            <p class="font-semibold">{{ space.name }}</p>
                            <p class="font-mono {{ muted }}">{{ space.value }}</p>
                        </div>
                        <div class="h-8 lg:col-span-2 bg-dodger-blue-200" style="width: {{ space.value|split(' / ')[0] }}"></div>
                    </li>
                {% endfor %}
            </ul>

            <ul class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
                {% for radius in brand.radius %}
                    <li class="{{ panel }} flex flex-col items-center text-center">
                        <div class="w-20 h-20 mb-4 bg-dodger-blue-600" style="border-radius: {{ radius.value|split(' / ')[0] }}"></div>
                        <p class="font-semibold">{{ radius.name }}</p>
                        <p class="font-mono {{ muted }}">{{ radius.value }}</p>
                    </li>
                {% endfor %}
            </ul>

            <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {% for shadow in brand.shadows %}
                    <li class="flex items-center gap-6 p-6 border border-gray-200 rounded-lg">
                        <div class="w-24 h-24 bg-white rounded-lg shrink-0" style="box-shadow: {{ shadow.value }}"></div>
                        <div>
                            <p class="font-semibold">{{ shadow.name }}</p>
                            <p class="font-mono text-xs text-gray-500">{{ shadow.value }}</p>
                            <p class="{{ muted }}">{{ shadow.usage }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section id="components" class="space-y-12">
            <h2 class="text-4xl font-bold">Components</h2>

            <div class="{{ panel }} space-y-6">
                <h3 class="text-2xl font-semibold">Buttons <span class="font-mono text-sm font-normal text-gray-500">_macro-button.twig</span></h3>
                {% for style in ['solid', 'outline', 'link'] %}
                    <div class="flex flex-wrap items-center gap-4">
                        <span class="w-20 font-mono {{ muted }}">{{ style }}</span>
                        {% for size in ['small', 'default', 'large'] %}
                            {{ buttons.render_button_link({ text: size|capitalize, link: '#components', style: style, size: size }) }}
                        {% endfor %}
                    </div>
                {% endfor %}
                <div class="flex flex-wrap items-center gap-4 p-6 rounded-lg bg-blue-950 dark">
                    <span class="w-20 font-mono text-sm text-gray-300">dark</span>
                    {{ buttons.render_button_link({ text: 'Solid', link: '#components' }) }}
                    {{ buttons.render_button_link({ text: 'Outline', link: '#components', style: 'outline' }) }}
                    {{ buttons.render_button_link({ text: 'White', link: '#components', style: 'white' }) }}
                </div>
            </div>

            <div class="{{ panel }} space-y-4">
                <h3 class="text-2xl font-semibold">Badges <span class="font-mono text-sm font-normal text-gray-500">_macro-badge.twig</span></h3>
                {{ badges.render_accent_badge({ title: 'Section accent' }) }}
            </div>

            <div class="space-y-6">
                <h3 class="text-2xl font-semibold">Cards <span class="font-mono text-sm font-normal text-gray-500">_macro-card.twig</span></h3>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                    {{ cards.simple({ title: 'Simple card', accent: 'Accent', entry: 'Used for posts and generic content listings.', link: '#components' }) }}
                    {{ cards.customer_story({ title: 'Customer story card', entry: 'Used in the post carousel for customer stories.', link: '#components' }) }}
                    {{ cards.testimonial({ quote: '<p>Used by the featured testimonials section.</p>', name: 'Jane Doe', position: 'Customer' }) }}
                </div>
            </div>
        </section>

        <section id="icons" class="space-y-6">
            <h2 class="text-4xl font-bold">Icons</h2>
            <p class="{{ muted }}">SVGs in <code>public/icons/&lt;set&gt;/icon-&lt;name&gt;.svg</code>, rendered with <code>icons.icon({ path, name, classes })</code>.</p>
            {% set icon_sets = {
                arrows: ['arrow-long', 'arrow-right', 'chevron-down', 'chevron-left', 'chevron-right'],
                controls: ['bars-3', 'bars-3-bottom-left', 'bars-3-bottom-right'],
                social: ['facebook', 'instagram', 'linkedin', 'twitter', 'x', 'youtube'],
            } %}
            <ul class="grid grid-cols-3 gap-4 md:grid-cols-6 lg:grid-cols-8">
                {% for set, names in icon_sets %}
                    {% for name in names %}
                        <li class="flex flex-col items-center gap-2 p-4 text-center border border-gray-200 rounded-lg">
                            {{ icons.icon({ path: set, name: name, classes: ['size-8', 'text-dodger-blue-600'] }) }}
                            <span class="font-mono text-xs text-gray-500">{{ set }}/{{ name }}</span>
                        </li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>

    </div>
</div>
{% endblock %}
