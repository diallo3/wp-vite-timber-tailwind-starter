{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        {% set steps = component.steps %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content space-y-6 inview-item">
            <header class="space-y-4 {{ section_class }}__header lg:pt-10">
                {% if has_accent and accent %}
                    <div class="inview-item">
                        {{ badges.render_accent_badge({
                            title: accent,
                        })}}
                    </div>
                {% endif %}

                {% if has_title and title %}
                    <div class="tracking-tight inview-item text-pretty dark:text-white {{ section_class }}__title">
                        {{ headings.render_heading(2,{
                            title: title,
                            size: 'text-3xl sm:fluid-text-4xl',
                            weight: 'font-bold',
                            preview: is_preview
                        }) }}
                    </div>
                {% endif %}
            </header>
            
            {# Entry content #}
            {% if has_entry and entry %}
                <div class="{{ section_class }}__entry lg:max-w-4xl">
                    {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                        {% block prose_content %}
                            {{ entry|raw }}
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endif %}

            {# step list #}
            <ol id="featured-step-list" class="mt-8 hiw-list {{ section_class }}__list step-list inview-container">
                {% for item in steps %}
                    {% set step_options = item.step_options ?: [] %}
                    <li id="step-{{ loop.index }}" class="hiw-list__item step-list__item inview-item">

                        {% include "@Components/content/section_feature_how_it_works/partials/_partial-step-content.twig" with {
                            image: 'image' in step_options ? item.image : null,
                            accent: 'accent' in step_options ? item.accent : null,
                            title: 'title' in step_options ? item.title : null,
                            entry: 'entry' in step_options ? item.entry : null,
                            ctas: 'ctas' in step_options ? cta_group(item.ctas) : [],
                        } %}

                    </li>
                {% endfor %}
            </ol>

            {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'pt-8', list_class: 'justify-center lg:flex-row' } only %}
        </div>
    {% endblock %}
{% endembed %}
