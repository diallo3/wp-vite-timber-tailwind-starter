{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% set features = component.features %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content space-y-6 lg:space-y-12">
            {% include "@Components/content/section_content_with_icons/partials/_partial-section-header.twig" %}

            {% if features %}
                <dl class="grid grid-cols-1 gap-8 lg:grid lg:grid-cols-3 {{ section_class }}__list inview-container">
                    {% for item in features %}
                        {% include "@Components/content/section_content_with_icons/partials/_partial-section-icon-entry.twig" %}
                    {% endfor %}
                </dl>
            {% endif %}

            {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'py-6', list_class: 'justify-center lg:flex-row lg:items-end' } only %}
        </div>
    {% endblock %}
{% endembed %}
