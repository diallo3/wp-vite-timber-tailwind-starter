{
	"name": "deepspacerobots/wordpress-twig-boilerplate",
	"description": "Starter theme to build a WP theme with Vite, Timber and ACF",
	"type": "wordpress-theme",
	"license": "MIT",
	"authors": [
		{
			"email": "andrew@deepspacerobots.com",
			"name": "thisanimus"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"php": ">=8.1",
		"timber/timber": "^2.0"
	},
	"config": {
		"platform": {
			"php": "8.1.29"
		},
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
