{# Company details from Theme Options (General tab), shown when Form Info's "Company info" toggle is on #}
{% import "@Elements/_macro-heading.twig" as headings %}

{% set name = site_options.company_title ?? null %}
{% set summary = site_options.company_summary ?? null %}
{% set address = site_options.address ?? {} %}
{% set phones = site_options.phone ?? [] %}
{% set emails = site_options.email ?? [] %}
{% set locality = [address.city ?? null, address.state_province_region ?? null]|filter(v => v)|join(', ') %}
{% set has_address = address.street_address ?? address.city ?? null %}

<div class="pt-6 mt-6 space-y-4 border-t border-white/20">
    {% if name %}
        {{ headings.render_heading(4, {
            title: name,
            color: 'text-white',
            size: 'fluid-text-lg',
            weight: 'font-semibold',
            preview: is_preview
        }) }}
    {% endif %}

    {% if summary %}
        <p class="text-gray-100">{{ summary }}</p>
    {% endif %}

    <dl class="space-y-4 text-base leading-7 text-gray-100">
        {% if has_address %}
            <div class="flex gap-x-3">
                <dt class="flex-none">
                    <span class="sr-only">Address</span>
                    <svg class="w-6 text-gray-300 h-7" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z"/>
                    </svg>
                </dt>
                <dd>
                    {% if address.street_address ?? false %}<span class="block">{{ address.street_address }}</span>{% endif %}
                    {% if address.street_address_2 ?? false %}<span class="block">{{ address.street_address_2 }}</span>{% endif %}
                    {% if locality or (address.postal_zip_code ?? false) %}<span class="block">{{ locality }} {{ address.postal_zip_code ?? '' }}</span>{% endif %}
                </dd>
            </div>
        {% endif %}

        {% if phones|length %}
            <div class="flex gap-x-3">
                <dt class="flex-none">
                    <span class="sr-only">Telephone</span>
                    <svg class="w-6 text-gray-300 h-7" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
                    </svg>
                </dt>
                <dd class="space-y-1">
                    {% for item in phones %}
                        {% set number = item.phone_number %}
                        <div class="text-sm">
                            {% if item.type %}<span class="font-semibold">{{ item.type }}:</span>{% endif %}
                            <a class="hover:text-white" href="tel:{{ number.number ?? '' }}">{{ number.national ?? number.number ?? '' }}</a>
                        </div>
                    {% endfor %}
                </dd>
            </div>
        {% endif %}

        {% if emails|length %}
            <div class="flex gap-x-3">
                <dt class="flex-none">
                    <span class="sr-only">Email</span>
                    <svg class="w-6 text-gray-300 h-7" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                    </svg>
                </dt>
                <dd class="space-y-1">
                    {% for item in emails %}
                        <div class="text-sm">
                            {% if item.type %}<span class="font-semibold">{{ item.type }}:</span>{% endif %}
                            <a class="hover:text-white" href="mailto:{{ item.email_address }}">{{ item.email_address }}</a>
                        </div>
                    {% endfor %}
                </dd>
            </div>
        {% endif %}
    </dl>
</div>
