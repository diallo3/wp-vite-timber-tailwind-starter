{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        {% set logo_sets = component.logo_sets %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content">
            <div class="grid mx-auto overflow-clip inview-container place-content-center">
                <div class="space-y-4 text-center lg:mx-0 {{ section_class }}__header inview-item">
                    {% if has_accent and accent %}
                        {{ badges.render_accent_badge({
                            title: accent,
                            color: 'text-blue-500',
                        }) }}
                    {% endif %}

                    {% if has_title and title %}
                        <hgroup class="{{ section_class }}__title">
                            {{ headings.render_heading(3, {
                                title: title,
                                size: 'text-4xl sm:text-5xl tracking-tight',
                                color: 'text-gray-800 dark:text-white',
                                weight: 'font-bold',
                                preview: is_preview,
                            }) }}
                        </hgroup>
                    {% endif %}

                    {% if has_entry and entry %}
                        <div class="mx-auto prose text-gray-500 lg:fluid-text-base/7 {{ section_class }}__entry dark:prose-invert">
                            {{ entry|raw }}
                        </div>
                    {% endif %}
                </div>

                {% for logo_set in logo_sets %}
                    <div
                        x-data="scrollerComponent"
                        xinit="init"
                        class="mx-auto mt-2 max-w-(--breakpoint-2xl)">
                        {% set direction = logo_set.direction %}
                        <div
                            x-ref="scroller"
                            class="scroller" data-direction="{{ direction ? 'right' }}" data-speed="slow">
                            <ul
                                x-ref="scrollerInner"
                                class="px-0 m-0 list-none scroller__inner">
                                {% for logo in logo_set.logos %}
                                    <li class="flex items-center w-full px-4 bg-white border border-blue-200 rounded-sm opacity-90 max-w-72 dark:border-transparent dark:invert-100">
                                        <img src="{{ logo.url }}" alt="{{ logo.title|esc_html }}" class="max-w-full scroller__item saturate-[.40]">
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'flex justify-center mt-8 py-2' } only %}
        </div>
    {% endblock %}
{% endembed %}
