{# Button Link Macro #}
{% macro render_button_link(options = {}) %}
    {% import "@Elements/_macro-icon.twig" as icons %}

    {# `link` and `href` are accepted interchangeably; styles/sizes match the CTA Group field choices. #}
    {% set href = options.href ?? options.link ?? null %}
    {% set target = options.target ?? null %}

    {% set options = {
        text: 'Button Text',
        icon: null,
        class: '',
    } | merge(options) %}

    {% set style_class = {
        solid: 'bg-primary text-on-primary hover:bg-primary-hover dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100',
        outline: 'border border-current text-primary hover:bg-primary-soft dark:text-white dark:hover:bg-white/10',
        white: 'bg-white text-gray-900 hover:bg-gray-100',
        link: 'px-0! text-primary underline-offset-4 hover:underline dark:text-white',
    } %}
    {% set style_class = style_class[options.style ?? 'solid'] ?? style_class.solid %}

    {% set size_class = {
        small: 'h-9 px-3 text-sm',
        default: 'h-11 px-5 text-base',
        large: 'h-13 px-7 text-lg',
    } %}
    {% set size_class = size_class[options.size ?? 'default'] ?? size_class.default %}

    {% set button_classes = [
        'inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current',
        style_class,
        size_class,
        options.class,
    ]|join(' ')|trim %}

    {% set button_text %}
        <span class="inline-flex">{{ options.text|esc_html }}</span>
        {# Include an optional SVG icon #}
        {% if options.icon is not null %}
            <span class="relative inline-flex items-center justify-center w-5 h-5 bg-current rounded-full">
                {{ icons.icon(options.icon, 'w-4 h-4') }}
            </span>
        {% endif %}
    {% endset %}

    {% if href is not empty %}
        <a href="{{ href|e('html_attr') }}" class="{{ button_classes }}"{% if target %} target="{{ target|e('html_attr') }}"{% if target == '_blank' %} rel="noopener"{% endif %}{% endif %}>
            {{ button_text }}
        </a>
    {% else %}
        <button type="button" class="{{ button_classes }}">
            {{ button_text }}
        </button>
    {% endif %}
    
{% endmacro %}




