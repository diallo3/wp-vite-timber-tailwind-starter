{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        {% set stats = component.stats %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content max-w-2xl mx-auto lg:max-w-none">
            <div class="text-center {{ section_class }}__header">
                {% if accent %}
                    {{ badges.render_accent_badge({
                        title: accent,
                        class: 'section-entry__accent',
                    }) }}
                {% endif %}

                <hgroup class="space-y-2 {{ section_class }}__title">
                    {{ headings.render_heading(2, {
                        title: title,
                    }) }}

                    {% if sub_title %}
                        {{ headings.render_heading(3, {
                            title: sub_title,
                        }) }}
                    {% endif %}
                </hgroup>

                {% if entry %}
                    {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                        {% block prose_content %}
                            {{ entry|raw }}
                        {% endblock %}
                    {% endembed %}
                {% endif %}
            </div>

            <div class="px-6 mx-auto max-w-7xl lg:px-8">
                <dl class="grid grid-cols-1 text-center gap-x-8 gap-y-16 lg:grid-cols-3 {{ section_class }}__items">
                    {% for item in stats %}
                        <div id="stat-list-{{ loop.index }}" class="flex flex-col p-8 inview-item">
                            <dt class="mx-auto text-base leading-7 text-center text-gray-600 lg:max-w-44">{{ item.entry }}</dt>
                            <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">{{ item.stat }}{{ item.caret }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            </div>
        </div>
    {% endblock %}
{% endembed %}
