{#
    Card macros. Every value is passed explicitly; nothing is read from the caller's context.

    {% import "@Elements/_macro-card.twig" as cards %}

    {{ cards.simple({ title: post.title, entry: post.excerpt, image: post.thumbnail.src, link: post.link }) }}
    {{ cards.customer_story({ title: item.title, entry: item.excerpt, image: item.thumbnail.src, link: item.link }) }}
    {{ cards.testimonial({ quote: quote, name: name, position: position }) }}
    {{ cards.team({ id: member.id, name: member.title, position: position, image: profile, bio: bio, social: social }) }}
#}

{#
    id, title, accent, entry, image (url), image_alt, link, button_text, clamp (line-clamp class)
#}
{% macro simple(card = {}) %}
    {% import "@Elements/_macro-heading.twig" as headings %}
    {% import "@Elements/_macro-badge.twig" as badges %}
    {% import "@Elements/_macro-image-object.twig" as images %}
    {% import "@Elements/_macro-button.twig" as buttons %}

    <article {% if card.id ?? false %}id="{{ card.id }}"{% endif %} class="relative flex flex-col overflow-hidden bg-white border border-gray-200 rounded-lg shadow-sm text-pretty size-full card-simple">
        <figure class="aspect-16/7 card-simple__featured">
            {{ images.render_image({ src: card.image ?? null, alt: card.image_alt ?? '' }) }}
        </figure>

        <div class="flex flex-col gap-2 p-5 pb-2.5 grow card-simple__body">
            <hgroup class="block space-y-2 text-balance card-simple__header lg:min-h-12">
                {% if card.accent ?? false %}
                    {{ badges.render_accent_badge({ title: card.accent, color: 'text-blue-600 dark:text-cyan-400' }) }}
                {% endif %}

                <div class="pe-8">
                    {{ headings.render_heading(3, {
                        title: card.title ?? '',
                        size: 'text-lg md:text-xl lg:text-2xl/7 line-clamp-2 tracking-tight',
                        weight: 'font-bold',
                    }) }}
                </div>
            </hgroup>

            {% if card.entry ?? false %}
                <div class="prose-sm prose card-simple__entry prose-p:leading-5 {{ card.clamp ?? 'line-clamp-3' }}">
                    {{ card.entry|raw }}
                </div>
            {% endif %}
        </div>

        {% if card.link ?? false %}
            <div class="w-full p-5 card-simple__footer">
                {{ buttons.render_button_link({
                    text: card.button_text ?? 'Read More',
                    link: card.link,
                    style: 'outline',
                    size: 'small',
                }) }}
            </div>
        {% endif %}
    </article>
{% endmacro %}

{#
    id, title, entry, image (url), image_alt, link, button_text
#}
{% macro customer_story(card = {}) %}
    {% import "@Elements/_macro-heading.twig" as headings %}
    {% import "@Elements/_macro-image-object.twig" as images %}
    {% import "@Elements/_macro-button.twig" as buttons %}

    <article {% if card.id ?? false %}id="customer-story-{{ card.id }}"{% endif %} class="relative flex flex-col items-start h-full overflow-hidden bg-white border-2 border-blue-100 rounded-md group card-customer-story">
        {% if card.image ?? false %}
            <figure class="relative flex items-center w-full px-4 pt-8 transition-all duration-200 ease-in-out bg-white aspect-16/8 max-w-64 saturate-0 group-hover:saturate-100 group-hover:scale-110">
                {{ images.render_image({ src: card.image, alt: card.image_alt ?? '', fit: 'object-contain w-full h-full' }) }}
            </figure>
        {% endif %}

        <div class="px-6 pb-4 card-customer-story__body">
            <div class="relative">
                <a href="{{ card.link ?? '#' }}" class="line-clamp-2">
                    <span class="absolute inset-0"></span>
                    {{ headings.render_heading(3, {
                        title: card.title ?? '',
                        color: 'text-blue-600 group-hover:text-blue-700 dark:text-cyan-400 dark:group-hover:text-cyan-600',
                        size: 'text-lg lg:text-xl',
                    }) }}
                </a>

                {% if card.entry ?? false %}
                    <p class="mt-2 text-sm leading-6 text-gray-600 line-clamp-3">{{ card.entry|raw }}</p>
                {% endif %}
            </div>

            {% if card.link ?? false %}
                <div class="relative py-2 mt-4">
                    {{ buttons.render_button_link({
                        text: card.button_text ?? 'Read Success Story',
                        link: card.link,
                        style: 'outline',
                        size: 'small',
                    }) }}
                </div>
            {% endif %}
        </div>
    </article>
{% endmacro %}

{#
    id, quote (html), name, position
#}
{% macro testimonial(card = {}) %}
    <figure {% if card.id ?? false %}id="testimonial-{{ card.id }}"{% endif %} class="relative flex h-full border border-gray-200 rounded-md shadow-xs testimonial-boxed bg-gray-50 dark:border-gray-700/75 dark:bg-gray-800 dark:text-gray-100">
        <div aria-hidden="true" class="absolute right-0 mt-1 mr-2 font-serif text-blue-200 rotate-180 opacity-75 text-8xl bottom-8 dark:text-blue-800">“</div>

        <div class="relative flex flex-col p-8 xl:p-10">
            <blockquote class="mb-5 prose leading-relaxed prose-base grow dark:prose-invert testimonial-boxed__quote">
                {{ (card.quote ?? "")|raw }}
            </blockquote>

            {% if (card.name ?? false) or (card.position ?? false) %}
                <figcaption class="testimonial-boxed__cite">
                    <p class="font-semibold text-blue-600 dark:text-blue-400 testimonial-boxed__name">{{ (card.name ?? "")|esc_html }}</p>
                    {% if card.position ?? false %}
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400 testimonial-boxed__position">{{ card.position }}</p>
                    {% endif %}
                </figcaption>
            {% endif %}
        </div>
    </figure>
{% endmacro %}

{#
    id, name, position, image (ACF image array), bio (html), social (url)
    The caller's wrapper must provide Alpine state: x-data="{ modalIsOpen: false }".
#}
{% macro team(card = {}) %}
    {% import "@Elements/_macro-icon.twig" as icons %}
    {% import "@Elements/_macro-heading.twig" as headings %}
    {% import "@Elements/_macro-image-object.twig" as images %}

    {% set image = card.image ?? null %}

    <div {% if card.id ?? false %}id="card-team-member-{{ card.id }}"{% endif %} class="card-team-member-default">
        <button type="button" class="block w-full overflow-hidden bg-gray-400 rounded-lg cursor-pointer aspect-3/2" @click="modalIsOpen = true" aria-label="Read bio for {{ (card.name ?? "")|esc_html }}"{% if not (card.bio ?? false) %} disabled{% endif %}>
            {{ images.render_image({ src: image.url ?? null, alt: image.alt ?? '' }) }}
        </button>

        <div class="flex justify-between px-1 py-2 card-team-member-default__entry">
            <div class="grow card-team-member-default__header">
                {{ headings.render_heading(3, {
                    title: card.name ?? '',
                    size: 'fluid-text-lg/2xl',
                    color: 'text-gray-900 dark:text-white',
                }) }}
                {% if card.position ?? false %}
                    <p class="text-sm font-semibold leading-7 text-blue-500 dark:text-gray-400">{{ card.position }}</p>
                {% endif %}
            </div>

            {% if card.social ?? false %}
                <div class="shrink">
                    <a href="{{ card.social|e('html_attr') }}" class="block pb-1 text-gray-400 transition-colors duration-200 ease-linear hover:text-gray-900 dark:hover:text-white" target="_blank" rel="noopener">
                        <span class="sr-only">LinkedIn for {{ (card.name ?? "")|esc_html }}</span>
                        {{ icons.icon({ path: 'social', name: 'linkedin', classes: ['size-5'] }) }}
                    </a>
                </div>
            {% endif %}
        </div>

        {% if card.bio ?? false %}
            {% embed "@Layouts/modals/_embed-modal-default.twig" %}
                {% block modal_content %}
                    {% import "@Elements/_macro-heading.twig" as headings %}
                    {% import "@Elements/_macro-image-object.twig" as images %}
                    <div class="grid gap-8 lg:grid-cols-2 lg:items-center member-bio">
                        <div class="space-y-8 member-bio__entry">
                            <div class="space-y-3 member-bio__title">
                                {{ headings.render_heading(3, { title: card.name ?? '', size: 'fluid-text-2xl', color: 'dark:text-white' }) }}
                                {% if card.position ?? false %}
                                    <p class="text-base leading-7 text-blue-500 dark:text-gray-400">{{ card.position }}</p>
                                {% endif %}
                            </div>
                            <div class="prose entry member-bio__bio dark:prose-invert">{{ card.bio|raw }}</div>
                        </div>
                        <figure class="relative overflow-hidden rounded-lg aspect-square member-bio__featured">
                            {{ images.render_image({ src: image.url ?? null, alt: image.alt ?? '' }) }}
                        </figure>
                    </div>
                {% endblock %}
            {% endembed %}
        {% endif %}
    </div>
{% endmacro %}
