{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-image-object.twig" as images %}

        {% set image = component.image.url %}
        {% set content_reverse = component.content_reverse %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content mx-auto">
            <div class="flex flex-col gap-12 {{ content_reverse ? 'lg:flex-row' : 'lg:flex-row-reverse' }} lg:items-center lg:gap-0">
                {% if image %}
                    <div class="relative flex-none group lg:w-1/2 {{ content_reverse ? 'lg:mr-16 xl:mr-16' : 'lg:ml-16 xl:ml-16' }}">
                        <figure class="relative overflow-hidden rounded-sm {{ section_class }}__figure">
                            {{ images.render_image({
                                src: image,
                                alt: title,
                                class: 'relative mx-auto ' ~ section_class ~ '__src',
                            }) }}
                        </figure>
                    </div>
                {% endif %}

                <div class="space-y-8 lg:w-1/2 {{ section_class }}__entry">
                    {% include "@Components/content/section_content_with_image/partials/_partial-section-header.twig" %}

                    {% if has_entry and entry %}
                        <div class="{{ section_class }}__entry">
                            {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                                {% block prose_content %}
                                    {{ entry|raw }}
                                {% endblock %}
                            {% endembed %}
                        </div>
                    {% endif %}

                    {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'py-6' } only %}
                </div>
            </div>
        </div>
    {% endblock %}
{% endembed %}
