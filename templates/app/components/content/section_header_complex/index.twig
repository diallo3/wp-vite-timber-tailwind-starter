{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content relative w-full py-8 pt-24 mx-auto text-white max-w-(--breakpoint-2xl) lg:pt-8 xl:pb-20">
            <div class="max-w-5xl mx-auto space-y-6 lg:mx-0">
                <div class="space-y-4 {{ section_class }}__header text-balance">
                    {{ badges.render_accent_badge({
                        title: accent ?: post.title,
                        color: 'text-white',
                    }) }}

                    <hgroup class="{{ section_class }}__title">
                        {{ headings.render_heading(1, {
                            title: title,
                            size: 'text-6xl md:text-7xl lg:fluid-text-7xl',
                            preview: is_preview,
                        }) }}

                        {% if sub_title %}
                            {{ headings.render_heading(2, {
                                title: sub_title,
                                size: 'fluid-text-2xl',
                                weight: 'font-medium',
                            }) }}
                        {% endif %}
                    </hgroup>
                </div>

                <div class="max-w-3xl {{ section_class }}__entry">
                    {% embed "@Layouts/prose/_embed-prose-hero.twig" with {
                        class: 'prose-invert',
                    } %}
                        {% block prose_content %}
                            {{ entry|raw }}
                        {% endblock %}
                    {% endembed %}
                </div>

                {% include "@Elements/_partial-ctas.twig" with {
                    ctas: ctas,
                    class: 'lg:pt-8',
                    list_class: 'gap-4 lg:flex-row lg:items-center',
                    style: 'white',
                    size: 'large',
                } only %}
            </div>
        </div>
    {% endblock %}
{% endembed %}
