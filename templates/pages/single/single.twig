{% extends "@Layouts/layout-base.twig" %}

{% block content %}
	{% if flexible_content %}
		{% include "@Layouts/flexible-content.twig" with { flexible_content: flexible_content } %}
	{% else %}
		<article class="px-8 py-16 mx-auto max-w-(--breakpoint-md) post-type-{{ post.post_type }}" id="post-{{ post.id }}">
			<header class="space-y-4">
				<h1 class="font-bold fluid-text-4xl text-pretty">{{ post.title|esc_html }}</h1>
				<p class="text-sm text-gray-600">
					<span>By</span> <a class="underline" href="{{ post.author.link }}">{{ post.author.name|esc_html }}</a>
					<span aria-hidden="true">&bull;</span>
					<time datetime="{{ post.date('c') }}">{{ post.date }}</time>
					{% if post.can_edit %}
						<span aria-hidden="true">&bull;</span>
						<a class="underline" href="{{ post.edit_link }}">{{ __('Edit') }}</a>
					{% endif %}
				</p>
			</header>

			{% if post.thumbnail %}
				<figure class="my-8 overflow-hidden rounded-lg">
					<img src="{{ post.thumbnail.src|resize(1200, 600) }}" alt="{{ post.thumbnail.alt }}" width="1200" height="600">
				</figure>
			{% endif %}

			<div class="prose max-w-none">
				{{ post.content|raw }}
			</div>
		</article>
	{% endif %}
{% endblock %}
