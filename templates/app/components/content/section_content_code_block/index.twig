{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        {% set code = component.code %}
        {% set markup = code.markup %}
        {% set css = code.css %}
        {% set javascript = code.javascript %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content space-y-6 inview-container">
            <div class="max-w-3xl mx-auto space-y-6 py-8 xl:py-32">
                <div class="space-y-2 {{ section_class }}__header text-balance inview-item">
                    {% if has_accent and accent %}
                        {{ badges.render_accent_badge({
                            title: accent,
                            color: 'text-white',
                        }) }}
                    {% endif %}
                    {% if has_title and title %}
                        <hgroup class="{{ section_class }}__title inview-item">
                            {{ headings.render_heading(2, {
                                title: title,
                                size: 'text-xl md:text-2xl lg:fluid-text-4xl',
                                preview: is_preview,
                            }) }}
                        </hgroup>
                    {% endif %}
                </div>

                {% if component.entry %}
                    <div class="{{ section_class }}__entry">
                        {% embed "@Layouts/prose/_embed-prose-section.twig" with {
                            class: 'prose-p:text-base lg:prose-p:text-xl prose-p:leading-8 lg:prose-p:leading-10 max-w-none inview-item prose-headings:font-serif prose-headings:fluid-text-3xl prose-headings:font-medium prose-headings:tracking-tight prose-li:fluid-text-lg prose-li:[&>p]:m-0 prose-base lg:fluid-text-sm',
                        } %}
                            {% block prose_content %}
                                {{ component.entry|raw }}
                            {% endblock %}
                        {% endembed %}
                    </div>
                {% endif %}

                <div class="{{ section_class }}__markup">
                    {{ markup }}
                </div>

                {% include "@Elements/_partial-ctas.twig" with { ctas: component.call_to_actions, class: 'py-6' } only %}
            </div>

            {% if javascript %}
                <template x-teleport="body">
                    <script>{{ javascript }}</script>
                </template>
            {% endif %}

            {% if css %}
                <template x-teleport="body">
                    <style>{{ css }}</style>
                </template>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
