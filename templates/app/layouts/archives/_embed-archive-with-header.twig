{#
    Archive shell: header, posts (archive_content block), related posts, pagination.

    archive_fields  "Post Archive Options" values: `content` is a Header Simple
                    component, `related` a Posts component. Both are optional.
    title           shown as the heading when there is no header component
#}
{% set header = (archive_fields.content[0] ?? null) ? archive_fields.content : null %}
{% set related = (archive_fields.related[0].posts ?? null) ? archive_fields.related : null %}

<div class="archive-container inview-container">

    <div class="archive-container__body space-y-8">
        {% if header %}
            {% include "@Layouts/_flexible-layout.twig" with {
                name: 'section_header_simple',
                component: { content: header },
                index: 1,
                is_preview: false,
            } %}
        {% elseif title ?? false %}
            {% embed "@Layouts/sections/_embed-section-full.twig" with {
                inview: 'false',
                padding_block: 'pt-16 pb-0 lg:pt-24',
            } %}
                {% block section_content %}
                    {% import "@Elements/_macro-heading.twig" as headings %}
                    {{ headings.render_heading(1, { title: title }) }}
                {% endblock %}
            {% endembed %}
        {% endif %}

        <div class="archive-container__content inview-content">
            {% block archive_content %}{% endblock %}
        </div>

        {% if related %}
            {% embed "@Layouts/sections/_embed-section-full.twig" with { component: { content: related } } %}
                {% block section_content %}
                    {% include "@Layouts/_flexible-layout.twig" with {
                        name: 'section_featured_posts',
                        component: { content: related },
                        index: 2,
                        is_preview: false,
                    } %}
                {% endblock %}
            {% endembed %}
        {% endif %}

        {% embed "@Layouts/sections/_embed-section-full.twig" with {
                inview: 'false',
                padding_block: 'pb-8 sm:pb-12 lg:pb-20 pt-0',
            } %}
            {% block section_content %}
                <div class="archive-pagination">
                    {% include '@Layouts/archives/partials/_partial-pagination-default.twig' with { pagination: posts.pagination({show_all: false, mid_size: 3, end_size: 2}) } %}
                </div>
            {% endblock %}
        {% endembed %}

    </div>
</div>
