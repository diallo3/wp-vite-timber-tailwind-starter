{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        {% set key_list = component.list %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content relative mx-auto space-y-4 inview-container">
            <div class="text-center {{ section_class }}__header inview-item">
                {{ badges.render_accent_badge({
                    title: title,
                    class: 'section-entry__accent',
                }) }}

                <hgroup class="{{ section_class }}__title">
                    {{ headings.render_heading(3, {
                        title: title,
                        size: 'fluid-text-4xl',
                    }) }}
                </hgroup>
            </div>

            <div class="max-w-4xl mx-auto space-y-8 text-center {{ section_class }}__entry inview-item">
                {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                    {% block prose_content %}
                        {{ entry|raw }}
                    {% endblock %}
                {% endembed %}
            </div>

            <div class="pt-2 mx-auto max-w-(--breakpoint-2xl) {{ section_class }}__items">
                <ul class="flex flex-wrap items-center gap-4 lg:justify-center">
                    {% for list in key_list %}
                        <li id="key-list-{{ loop.index }}" class="flex items-center pb-2 space-x-4 lg:text-center {{ section_class }}__item lg:pb-4 inview-item md:w-1/2 lg:w-1/4">
                            <span class="inline-flex grow-0 text-lg text-gray-600">{{ list.item }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'pt-8', list_class: 'justify-center lg:flex-row lg:items-center' } only %}
        </div>
    {% endblock %}
{% endembed %}
