{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-card.twig" as cards %}

        {% set testimonials = get_posts(component.testimonials) %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content px-4 mx-auto space-y-8 lg:px-8 xl:max-w-(--breakpoint-2xl) inview-container">
            <div class="text-center {{ section_class }}__header inview-item">
                {{ headings.render_heading(2, {
                    title: title,
                    color: 'text-black',
                    size: 'fluid-text-3xl',
                }) }}
            </div>

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 {{ section_class }}__list">
                {% for testimonial in testimonials %}
                    <div class="inview-item">
                        {{ cards.testimonial({
                            id: testimonial.id,
                            quote: testimonial.meta('quote'),
                            name: testimonial.meta('name'),
                            position: testimonial.meta('position'),
                        }) }}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endblock %}
{% endembed %}
