{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content flex flex-col justify-center gap-4 lg:flex-row lg:gap-8">
            <div class="w-full space-y-4 text-center {{ section_class }}__header">
                <div class="space-y-2">
                    {{ badges.render_accent_badge({
                        title: accent,
                        color: 'text-white',
                    }) }}
                    <hgroup class="{{ section_class }}__title text-balance">
                        {{ headings.render_heading(1, {
                            title: title,
                            size: 'text-4xl md:text-5xl lg:fluid-text-5xl',
                            preview: is_preview,
                        }) }}
                    </hgroup>

                    {% if has_entry and entry %}
                        <div class="max-w-4xl mx-auto {{ section_class }}__entry">
                            {% embed "@Layouts/prose/_embed-prose-hero.twig" %}
                                {% block prose_content %}
                                    {{ entry|raw }}
                                {% endblock %}
                            {% endembed %}
                        </div>
                    {% endif %}
                </div>

                <div class="aspect-w-16 aspect-h-9 {{ section_class }}__media">
                    {{ component.video|raw }}
                </div>

                {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'flex justify-center w-full py-6', list_class: 'w-auto lg:flex-row' } only %}
            </div>
        </div>
    {% endblock %}
{% endembed %}
