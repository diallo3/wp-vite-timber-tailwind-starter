{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-card.twig" as cards %}

        {% set posts = get_posts(component.posts) %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content mx-auto space-y-6 inview-container">
            <div class="space-y-4 lg:mx-0 {{ section_class }}__header inview-item">
                {% include "@Components/content/section_featured_posts/partials/_partial-section-header.twig" %}

                <div class="{{ section_class }}__entry inview-item lg:max-w-5xl">
                    {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                        {% block prose_content %}
                            {{ entry|raw }}
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>

            <ul role="list" class="grid max-w-2xl grid-cols-1 mx-auto gap-x-4 gap-y-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 {{ section_class }}__list">
                {% for item in posts %}
                    <li id="{{ section_class }}-{{ index }}-{{ loop.index }}" class="{{ section_class }}__item inview-item">
                        {{ cards.simple({
                            title: item.title,
                            entry: item.excerpt,
                            image: item.thumbnail.src ?? null,
                            image_alt: item.thumbnail.alt ?? '',
                            link: item.link,
                        }) }}
                    </li>
                {% endfor %}
            </ul>

            {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'flex justify-center mt-8 py-6' } only %}
        </div>
    {% endblock %}
{% endembed %}
