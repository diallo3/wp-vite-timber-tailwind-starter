{% set section_class = name|replace({'_': '-'}) %}

{% embed "@Layouts/sections/_embed-section-component-helper.twig" with {
    section_id_name: section_class,
    section_class_name: section_class ~ ' relative isolate overflow-hidden',
} %}
    {% block component_content %}
        {% import "@Elements/_macro-heading.twig" as headings %}
        {% import "@Elements/_macro-badge.twig" as badges %}

        {% set title_position = component.title_position %}
        {% set title_on_side = title_position is same as 'side' %}

        <div data-{{ section_class }}-content class="{{ section_class }}__content">
            {% if title_on_side %}
                <div class="flex flex-col gap-4 lg:flex-row lg:gap-8">
                    <div class="w-full space-y-2 lg:max-w-48 {{ section_class }}__header text-balance">
                        {{ badges.render_accent_badge({
                            title: accent,
                            color: 'text-white',
                        }) }}

                        <hgroup class="{{ section_class }}__title">
                            {{ headings.render_heading(2, {
                                title: title,
                                size: 'fluid-text-base font-semibold uppercase',
                                color: 'text-blue-600 dark:text-cyan-400',
                                preview: is_preview,
                            }) }}
                        </hgroup>

                        {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'py-6 mt-8' } only %}
                    </div>

                    <div class="grow w-full">
                        {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                            {% block prose_content %}
                                {{ component.entry|raw }}
                            {% endblock %}
                        {% endembed %}
                    </div>
                </div>
            {% else %}
                <div class="space-y-6 lg:max-w-7xl">
                    <div class="space-y-2 {{ section_class }}__header text-balance">
                        {{ badges.render_accent_badge({
                            title: accent,
                            color: 'text-white',
                        }) }}

                        <hgroup class="{{ section_class }}__title">
                            {{ headings.render_heading(2, {
                                title: title,
                                size: 'text-xl md:text-2xl lg:fluid-text-4xl',
                                preview: is_preview,
                            }) }}
                        </hgroup>
                    </div>

                    {% embed "@Layouts/prose/_embed-prose-section.twig" %}
                        {% block prose_content %}
                            {{ component.entry|raw }}
                        {% endblock %}
                    {% endembed %}

                    {% include "@Elements/_partial-ctas.twig" with { ctas: ctas, class: 'py-6' } only %}
                </div>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
