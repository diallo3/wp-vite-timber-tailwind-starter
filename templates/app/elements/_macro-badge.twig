{% macro render_accent_badge(options={}) %}

    {% set options = {
        title: options.title | default('Badge'),
    } | merge(options)  %}

    {# accent bagdge #}
    <span class="block text-base lg:text-sm font-semibold tracking-widest lg:tracking-[0.25rem] text-dodger-blue-600 uppercase">
        {{ options.title|esc_html }}
    </span>
{% endmacro %}

{% macro render_contained_badge(options=[]) %}

    {% set options = {
        title: options.title | default('Badge'),
        color: options.color | default('dodger-blue'),
        size: options.size | default('text-sm'),
    } | merge(options)  %}

    {# Full class names so Tailwind can detect them #}
    {% set color_classes = {
        'dodger-blue': 'bg-dodger-blue-950 text-dodger-blue-600',
        'gray': 'bg-gray-950 text-gray-400',
        'green': 'bg-green-950 text-green-500',
        'red': 'bg-red-950 text-red-500',
    }[options.color] ?? 'bg-dodger-blue-950 text-dodger-blue-600' %}

    {# contained bagdge #}
    <span class="{{ options.size }} inline-flex items-center px-2.5 py-0.5 rounded-full  font-medium {{ color_classes }} capitalize">
        {{ options.title|esc_html }}
    </span>
    
{% endmacro %}